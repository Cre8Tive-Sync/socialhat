# Copy to .env and fill in. .env is gitignored; this file is the template.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any tool-calling model on OpenRouter; defaults to anthropic/claude-opus-5.
# OPENROUTER_MODEL=anthropic/claude-opus-5

# Optional. Where captured leads are POSTed as JSON (Zapier, Make, etc.).
# LEAD_WEBHOOK=
